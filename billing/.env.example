# Stripe sandbox/test configuration only. Never commit real values.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# One Stripe Product per paid tier.
STRIPE_PRODUCT_HELIOS_PLUS=
STRIPE_PRODUCT_HELIOS_PRO=

# Monthly recurring Prices. Add annual Price IDs later if/when offered.
STRIPE_PRICE_HELIOS_PLUS_MONTHLY=
STRIPE_PRICE_HELIOS_PRO_MONTHLY=

# Public application URLs used to return from hosted Checkout / Customer Portal.
HELIOS_BILLING_SUCCESS_URL=http://127.0.0.1:9680/billing/success
HELIOS_BILLING_CANCEL_URL=http://127.0.0.1:9680/billing
HELIOS_BILLING_PORTAL_RETURN_URL=http://127.0.0.1:9680/settings/billing
